generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  HR
  ADMIN
}

enum OrderStatus {
  RESERVED
  COLLECTED
  CANCELLED
}

model User {
  commentLikes CommunityCommentLike[]
  avatarUpdatedAt DateTime?
  profilePhoto ProfilePhoto?
  redemptionNotices RedemptionNotice[]
  redemptionRequests RedemptionRequest[]
  id                      String             @id @default(cuid())
  name                    String
  email                   String             @unique
  mustChangePassword      Boolean            @default(false)
  passwordHash            String
  role                    Role               @default(EMPLOYEE)
  active                  Boolean            @default(true)
  balance                 Int                @default(0)
  createdAt               DateTime           @default(now())
  communityGrant          CommunityGrant?    @relation("CommunityMember")
  assignedCommunityGrants CommunityGrant[]   @relation("CommunityAssigner")
  assignedPhotoMissions   PhotoMission[]     @relation("MissionReviewer")
  reviewedPhotoEvidence   PhotoEvidence[]    @relation("EvidenceReviewer")
  mediaLikes              MediaLike[]
  mediaComments           MediaComment[]     @relation("MediaCommentAuthor")
  moderatedMediaComments  MediaComment[]     @relation("MediaCommentModerator")
  moderatedComments       CommunityComment[] @relation("CommentModerator")
  posts                   CommunityPost[]
  albums                  CommunityAlbum[]
  events                  CommunityEvent[]
  media                   CommunityMedia[]
  likes                   CommunityLike[]
  comments                CommunityComment[]
  evidence                PhotoEvidence[]
  reviews                 EvidenceReview[]
  sessions                Session[]
  ledger                  Ledger[]
  orders                  Order[]
  completions             Completion[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String
  imageUrl    String
  category    String
  price       Int
  active      Boolean @default(true)
  batches     Batch[]
  orders      Order[]
}

model Batch {
  id          String       @id @default(cuid())
  code        String       @unique
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  expiresAt   DateTime
  quantity    Int
  allocations Allocation[]

  @@index([productId, expiresAt])
}

model Order {
  notices RedemptionNotice[]
  purchaseRequest RedemptionRequest?
  pickupCode String @unique @default(dbgenerated("gen_random_uuid()::text"))
  collectedAt DateTime?
  collectedById String?
  collectedByName String?
  cancelledAt DateTime?
  cancelledByName String?
  share RedemptionShare?
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  productId   String
  product     Product      @relation(fields: [productId], references: [id])
  quantity    Int
  cost        Int
  status      OrderStatus  @default(RESERVED)
  createdAt   DateTime     @default(now())
  allocations Allocation[]

  @@index([userId, createdAt])
}

model Allocation {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id])
  quantity Int
}

model Ledger {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  description String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model Mission {
  id          String        @id @default(cuid())
  title       String
  description String
  reward      Int
  question    String
  options     Json
  answer      Int
  active      Boolean       @default(true)
  endsAt      DateTime
  completions Completion[]
  photoConfig PhotoMission?
}

model Completion {
  recognitionConsent Boolean        @default(false)
  recognitionPost    CommunityPost?
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  missionId          String
  mission            Mission        @relation(fields: [missionId], references: [id])
  createdAt          DateTime       @default(now())

  @@unique([userId, missionId])
}

model Audit {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  details   String
  createdAt DateTime @default(now())
}

model LoginAttempt {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// Additive community module. Existing roles and financial tables remain intact.
enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommunityVisibility {
  INTERNAL
  MANAGEMENT
}

enum EvidenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model CommunityGrant {
  userId     String   @id
  user       User     @relation("CommunityMember", fields: [userId], references: [id])
  publish    Boolean  @default(false)
  review     Boolean  @default(false)
  moderate   Boolean  @default(false)
  leadership Boolean  @default(false) // Legacy only; never used for authorization.
  photos     Boolean  @default(false)
  albums     Boolean  @default(false)
  events     Boolean  @default(false)
  missions   Boolean  @default(false)
  recognize  Boolean  @default(false)
  assigner   User     @relation("CommunityAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)
  assignedBy String
  updatedAt  DateTime @updatedAt
}

model CommunityEvent {
  imageAuthorization Boolean?
  restrictedChecked  Boolean?
  media              CommunityMedia[]
  id                 String              @id @default(cuid())
  title              String
  description        String
  location           String
  startsAt           DateTime
  endsAt             DateTime
  status             PublicationStatus   @default(DRAFT)
  visibility         CommunityVisibility @default(INTERNAL)
  authorId           String
  author             User                @relation(fields: [authorId], references: [id])
  posts              CommunityPost[]
  albums             CommunityAlbum[]
  createdAt          DateTime            @default(now())

  @@index([status, startsAt])
}

model CommunityAlbum {
  missionMoment MissionMoment?
  category           String              @default("Eventos")
  imageAuthorization Boolean?
  restrictedChecked  Boolean?
  thread             CommunityThread?
  id                 String              @id @default(cuid())
  title              String
  description        String
  eventDate          DateTime
  status             PublicationStatus   @default(DRAFT)
  visibility         CommunityVisibility @default(INTERNAL)
  authorId           String
  author             User                @relation(fields: [authorId], references: [id])
  eventId            String?
  event              CommunityEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  media              CommunityMedia[]
  posts              CommunityPost[]
  createdAt          DateTime            @default(now())

  @@index([status, eventDate])
}

model CommunityPost {
  redemptionShare RedemptionShare?
  completionId          String?             @unique
  completion            Completion?         @relation(fields: [completionId], references: [id], onDelete: Restrict)
  recognitionIdentified Boolean             @default(false)
  id                    String              @id @default(cuid())
  title                 String
  description           String
  category              String
  status                PublicationStatus   @default(DRAFT)
  visibility            CommunityVisibility @default(INTERNAL)
  publishedAt           DateTime            @default(now())
  pinned                Boolean             @default(false)
  authorId              String
  author                User                @relation(fields: [authorId], references: [id])
  eventId               String?
  event                 CommunityEvent?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  albumId               String?
  album                 CommunityAlbum?     @relation(fields: [albumId], references: [id], onDelete: SetNull)
  evidenceId            String?             @unique
  evidence              PhotoEvidence?      @relation(fields: [evidenceId], references: [id])
  imageAuthorization    Boolean             @default(false)
  restrictedChecked     Boolean             @default(false)
  media                 CommunityMedia[]
  likes                 CommunityLike[]
  comments              CommunityComment[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, pinned, publishedAt])
}

model CommunityLike {
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())

  @@id([postId, userId])
}

model CommunityComment {
  parentId String?
  parent CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict)
  replies CommunityComment[] @relation("CommentReplies")
  replyToId String?
  replyTo CommunityComment? @relation("CommentReplyTarget", fields: [replyToId], references: [id], onDelete: Restrict)
  mentions CommunityComment[] @relation("CommentReplyTarget")
  likes CommunityCommentLike[]
  @@index([postId, parentId, createdAt, id])
  requestId        String?       @unique
  deletedAt        DateTime?
  id               String        @id @default(cuid())
  postId           String
  post             CommunityPost @relation(fields: [postId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  text             String
  hidden           Boolean       @default(false)
  moderator        User?         @relation("CommentModerator", fields: [moderatedBy], references: [id], onDelete: Restrict)
  moderatedBy      String?
  moderationReason String?
  createdAt        DateTime      @default(now())

  @@index([postId, hidden, createdAt])
}

model PhotoMission {
  id                 String            @id @default(cuid())
  missionId          String            @unique
  mission            Mission           @relation(fields: [missionId], references: [id])
  category           String
  startsAt           DateTime
  maxPhotos          Int               @default(3)
  participationLimit Int               @default(100)
  allowResubmit      Boolean           @default(false)
  status             PublicationStatus @default(DRAFT)
  responsible        User?             @relation("MissionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerId         String?
  media              CommunityMedia[]
  evidence           PhotoEvidence[]

  @@index([status, startsAt])
}

model PhotoEvidence {
  caption String?
  moments MissionMoment[]
  id             String           @id @default(cuid())
  photoMissionId String
  photoMission   PhotoMission     @relation(fields: [photoMissionId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  status         EvidenceStatus   @default(PENDING)
  shareConsent   Boolean          @default(false)
  attempts       Int              @default(1)
  submittedAt    DateTime         @default(now())
  reviewedAt     DateTime?
  evaluatedBy    User?            @relation("EvidenceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerId     String?
  reason         String?
  media          CommunityMedia[]
  reviews        EvidenceReview[]
  post           CommunityPost?

  @@unique([photoMissionId, userId])
  @@index([status, submittedAt])
}

model EvidenceReview {
  id         String         @id @default(cuid())
  evidenceId String
  evidence   PhotoEvidence  @relation(fields: [evidenceId], references: [id])
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  status     EvidenceStatus
  reason     String?
  createdAt  DateTime       @default(now())

  @@index([evidenceId, createdAt])
}

// Private persistent media: never served from /public or a public bucket.
model CommunityMedia {
  position       Int              @default(0)
  eventId        String?
  event          CommunityEvent?  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  thread         CommunityThread?
  attempt        Int              @default(1)
  id             String           @id @default(uuid())
  ownerId        String
  owner          User             @relation(fields: [ownerId], references: [id])
  bytes          Bytes
  width          Int
  height         Int
  mime           String           @default("image/webp")
  cover          Boolean          @default(false)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  postId         String?
  post           CommunityPost?   @relation(fields: [postId], references: [id], onDelete: Restrict)
  albumId        String?
  album          CommunityAlbum?  @relation(fields: [albumId], references: [id], onDelete: Restrict)
  photoMissionId String?
  photoMission   PhotoMission?    @relation(fields: [photoMissionId], references: [id], onDelete: Restrict)
  evidenceId     String?
  evidence       PhotoEvidence?   @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([postId])
  @@index([albumId])
  @@index([evidenceId])
}

model CommunityThread {
  id       String          @id @default(uuid())
  albumId  String?         @unique
  album    CommunityAlbum? @relation(fields: [albumId], references: [id], onDelete: Restrict)
  mediaId  String?         @unique
  media    CommunityMedia? @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  likes    MediaLike[]
  comments MediaComment[]
}

model MediaLike {
  threadId  String
  thread    CommunityThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())

  @@id([threadId, userId])
}

model MediaComment {
  id               String          @id @default(cuid())
  requestId        String?         @unique
  threadId         String
  thread           CommunityThread @relation(fields: [threadId], references: [id], onDelete: Restrict)
  userId           String
  user             User            @relation("MediaCommentAuthor", fields: [userId], references: [id], onDelete: Restrict)
  text             String
  hidden           Boolean         @default(false)
  deletedAt        DateTime?
  moderatedBy      String?
  moderator        User?           @relation("MediaCommentModerator", fields: [moderatedBy], references: [id], onDelete: Restrict)
  moderationReason String?
  createdAt        DateTime        @default(now())

  @@index([threadId, hidden, createdAt])
  @@index([userId, createdAt])
}

model RedemptionShare {
 orderId String @id
 order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
 postId String @unique
 post CommunityPost @relation(fields: [postId], references: [id], onDelete: Restrict)
 createdAt DateTime @default(now())
 reports RedemptionReport[]
}
model RedemptionReport {
 postId String
 share RedemptionShare @relation(fields: [postId], references: [postId], onDelete: Restrict)
 reporterId String
 reason String
 createdAt DateTime @default(now())
 @@id([postId, reporterId])
}
model PickupAttempt {
 actorId String @id
 windowStart DateTime @default(now())
 attempts Int @default(0)
}

model RedemptionRequest {
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Restrict)
 key String
 productId String
 quantity Int
 unitPrice Int
 orderId String @unique
 order Order @relation(fields:[orderId], references:[id], onDelete:Restrict)
 createdAt DateTime @default(now())
 @@id([userId,key])
}
model RedemptionNotice {
 id String @id @default(cuid())
 userId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 orderId String
 order Order @relation(fields:[orderId], references:[id], onDelete:Restrict)
 readAt DateTime?
 createdAt DateTime @default(now())
 @@unique([userId,orderId])
 @@index([userId,readAt,createdAt])
}

model ProfilePhoto {
 userId String @id
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 bytes Bytes
 updatedAt DateTime @default(now()) @updatedAt
}

model CommunityCommentLike {
 commentId String
 comment CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 createdAt DateTime @default(now())
 @@id([commentId, userId])
}

model MissionMoment {
 id String @id @default(cuid())
 evidenceId String
 evidence PhotoEvidence @relation(fields:[evidenceId],references:[id],onDelete:Restrict)
 attempt Int
 albumId String @unique
 album CommunityAlbum @relation(fields:[albumId],references:[id],onDelete:Restrict)
 createdAt DateTime @default(now())
 @@unique([evidenceId,attempt])
}
